    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik Face ID om A-Alerts te ontgrendelen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Face ID to unlock A-Alerts."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je locatie wordt gebruikt om te tonen hoe ver een melding bij je vandaan is en, als je Mijn buurt aanzet, voor meldingen in jouw buurt. Daarvoor gaat alleen een afgeronde locatie (op ±100 m) naar onze server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is used to show how far away an alert is and, if you turn on My area, for alerts near you. Only a rounded location (to about 100 m) is sent to our server for that."
          }
        }
      }
    }
  }
}