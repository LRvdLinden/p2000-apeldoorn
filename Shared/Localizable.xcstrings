    "Tik op de kaart op een helikopter of vliegtuig en dan op de bel: je krijgt een pushmelding als dat toestel opstijgt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a helicopter or aircraft on the map and then the bell: you get a notification when that aircraft takes off."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de kaart op een helikopter of vliegtuig en dan op de bel: je krijgt een pushmelding als dat toestel opstijgt."
          }
        }
      }
    },
    "Tik op de ster om een eenheid te volgen. Je krijgt dan ook meldingen van die capcode buiten je plaatsen en straal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the star to follow a unit. You then also get alerts for that capcode outside your places and radius."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de ster om een eenheid te volgen. Je krijgt dan ook meldingen van die capcode buiten je plaatsen en straal."
          }
        }
      }
    },
