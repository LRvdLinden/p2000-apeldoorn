        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helicopter positions come from adsb.lol (open data). A helicopter flying low or standing on the ground is sometimes not visible. Stations (fire, ambulance and police) come from OpenStreetMap."
          }
        },
        "nl": {
