    "Automatisch volgt de lichte of donkere modus van je apparaat. Met rustige kleuren vallen meldingen en helikopters beter op. Satelliet en hybride tonen ook het reliëf in 3D.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic follows your device's light or dark mode. With muted colours, alerts and helicopters stand out more. Satellite and hybrid also show the terrain in 3D."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch volgt de lichte of donkere modus van je apparaat. Met rustige kleuren vallen meldingen en helikopters beter op. Satelliet en hybride tonen ook het reliëf in 3D."
          }
        }
      }
    },
