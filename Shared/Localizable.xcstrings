    "Zet de stille modus aan om in het ingestelde tijdsblok geen pushmeldingen te krijgen. Met 'Kritieke meldingen' komen A1- en P1-meldingen ook in de stille modus door.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on quiet mode to get no push notifications during the set time. With 'Critical alerts', A1 and P1 alerts still come through in quiet mode."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de stille modus aan om in het ingestelde tijdsblok geen pushmeldingen te krijgen. Met 'Kritieke meldingen' komen A1- en P1-meldingen ook in de stille modus door."
          }
        }
      }
    },
