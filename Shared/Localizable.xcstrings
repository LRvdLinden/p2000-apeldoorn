    "Kies per code of je een melding wilt. Je krijgt een melding bij een nieuwe waarschuwing of als hij wordt opgeschaald, niet bij elke aanpassing. Bron: KNMI.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose per code whether you want a notification. You get one for a new warning or when it is raised, not for every change. Source: KNMI."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies per code of je een melding wilt. Je krijgt een melding bij een nieuwe waarschuwing of als hij wordt opgeschaald, niet bij elke aanpassing. Bron: KNMI."
          }
        }
      }
    },
