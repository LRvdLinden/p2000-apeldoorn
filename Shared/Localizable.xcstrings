    "A-Alerts is aanvullend op NL-Alert en vervangt het niet. Een NL-Alert komt ook rechtstreeks op je telefoon binnen. Bel bij nood altijd 112.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A-Alerts complements NL-Alert and does not replace it. An NL-Alert also arrives directly on your phone. Always call 112 in an emergency."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "A-Alerts is aanvullend op NL-Alert en vervangt het niet. Een NL-Alert komt ook rechtstreeks op je telefoon binnen. Bel bij nood altijd 112."
          }
        }
      }
    },
    "A-Alerts is aanvullend op NL-Alert. Volg altijd het advies in het NL-Alert-bericht.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A-Alerts supplements NL-Alert. Always follow the advice in the NL-Alert message."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "A-Alerts is aanvullend op NL-Alert. Volg altijd het advies in het NL-Alert-bericht."
          }
        }
      }
    },
