    "Je Apple-koppeling, instellingen en bewaarde meldingen worden van al je apparaten verwijderd. Dit kan niet ongedaan worden gemaakt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple link, settings and saved alerts will be removed from all your devices. This cannot be undone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple-koppeling, instellingen en bewaarde meldingen worden van al je apparaten verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
