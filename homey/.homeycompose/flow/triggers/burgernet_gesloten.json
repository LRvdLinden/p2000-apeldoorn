{
  "title": {
    "en": "Een Burgernet-melding is gesloten",
    "nl": "Een Burgernet-melding is gesloten"
  },
  "hint": {
    "nl": "De Burgernet-actie is beëindigd. Bericht = kant-en-klaar afsluitbericht: afloopbericht, eventuele updates en het startbericht, elk met tijd. Afloopbericht = alleen de afsluittekst van Burgernet.",
    "en": "Message = ready-made closing message: closing message, any updates and the start message, each with its time. Closing message = only the closing text from Burgernet."
  },
  "titleFormatted": {
    "en": "Een Burgernet-melding in [[plaats]] is gesloten",
    "nl": "Een Burgernet-melding in [[plaats]] is gesloten"
  },
  "args": [
    {
      "name": "plaats",
      "type": "autocomplete",
      "title": {
        "en": "Plaats",
        "nl": "Plaats"
      },
      "placeholder": {
        "en": "Alle plaatsen",
        "nl": "Alle plaatsen"
      }
    }
  ],
  "tokens": [
    {
      "name": "afbeelding",
      "type": "image",
      "title": {
        "nl": "Burgernet-afbeelding (kaart met de plek)",
        "en": "Burgernet image (map with the spot)"
      }
    },
    {
      "name": "afbeelding_url",
      "type": "string",
      "title": {
        "nl": "Afbeelding (URL, kaart zonder watermerk of banner)",
        "en": "Image (URL, map without watermark or banner)"
      },
      "example": "https://raw.githubusercontent.com/LRvdLinden/P2000-brand/main/banners/banner-burgernet-apeldoorn.png"
    },
    {
      "name": "bericht",
      "type": "string",
      "title": {
        "nl": "Burgernet-afsluitbericht (kant-en-klaar)",
        "en": "Burgernet closing message (ready-made)"
      },
      "example": "Burgernet melding in APELDOORN gesloten! …"
    },
    {
      "name": "titel",
      "type": "string",
      "title": {
        "nl": "Burgernet-titel",
        "en": "Burgernet title"
      },
      "example": "Vermissing"
    },
    {
      "name": "afloop",
      "type": "string",
      "title": {
        "nl": "Afloopbericht",
        "en": "Closing message"
      },
      "example": {
        "en": "De politie Apeldoorn dankt u voor het uitkijken.",
        "nl": "De politie Apeldoorn dankt u voor het uitkijken."
      }
    },
    {
      "name": "tekst",
      "type": "string",
      "title": {
        "nl": "Startbericht",
        "en": "Start message"
      },
      "example": "De politie zoekt naar …"
    },
    {
      "name": "update",
      "type": "string",
      "title": {
        "nl": "Laatste update",
        "en": "Latest update"
      },
      "example": {
        "en": "Een van de mannen draagt een rode pet.",
        "nl": "Een van de mannen draagt een rode pet."
      }
    },
    {
      "name": "tijdlijn",
      "type": "string",
      "title": {
        "nl": "Alle Burgernet-berichten (nieuwste eerst)",
        "en": "All Burgernet messages (newest first)"
      },
      "example": {
        "en": "Afloopbericht (10:41): … Startbericht (09:06): …",
        "nl": "Afloopbericht (10:41): … Startbericht (09:06): …"
      }
    },
    {
      "name": "aantal_updates",
      "type": "number",
      "title": {
        "nl": "Aantal updates",
        "en": "Number of updates"
      },
      "example": 1
    },
    {
      "name": "soort",
      "type": "string",
      "title": {
        "nl": "Soort oproep (bijv. vermissing)",
        "en": "Type of call (e.g. missing person)"
      },
      "example": "Zware windstoten"
    },
    {
      "name": "plaats",
      "type": "string",
      "title": {
        "nl": "Plaats",
        "en": "Place"
      },
      "example": "Apeldoorn"
    },
    {
      "name": "status",
      "type": "string",
      "title": {
        "nl": "Status",
        "en": "Status"
      },
      "example": "Actief"
    },
    {
      "name": "begin",
      "type": "string",
      "title": {
        "nl": "Begin (datum en tijd)",
        "en": "Start (date and time)"
      },
      "example": "06/11/2026 13:05"
    },
    {
      "name": "einde",
      "type": "string",
      "title": {
        "nl": "Einde (datum en tijd)",
        "en": "End (date and time)"
      },
      "example": "06/11/2026 13:19"
    },
    {
      "name": "link",
      "type": "string",
      "title": {
        "nl": "Link naar de melding op a-alerts.nl",
        "en": "Link to the alert on a-alerts.nl"
      },
      "example": "https://a-alerts.nl/waarschuwing/burgernet:3967274"
    },
    {
      "name": "bron_link",
      "type": "string",
      "title": {
        "nl": "Link naar burgernet.nl",
        "en": "Link to burgernet.nl"
      },
      "example": "https://www.burgernet.nl/burgernet/3967274"
    },
    {
      "name": "whatsapp_link",
      "type": "string",
      "title": {
        "nl": "WhatsApp-groeplink",
        "en": "WhatsApp group link"
      },
      "example": "https://korturl.nl/?r=wa-burgernet"
    }
  ]
}
