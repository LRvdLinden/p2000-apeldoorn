# A-Alerts – a-alerts.nl
# Upload naar de webroot van a-alerts.nl. Laat p2000-apeldoorn.nl (en www) als alias
# naar dezelfde map wijzen, of zet dit bestand ook in de webroot van p2000-apeldoorn.nl.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Oude domein → nieuw domein (301, pad en query blijven behouden)
  RewriteCond %{HTTP_HOST} ^(www\.)?p2000-apeldoorn\.nl$ [NC]
  RewriteRule ^(.*)$ https://a-alerts.nl/$1 [R=301,L,NE]

  # www → zonder www
  RewriteCond %{HTTP_HOST} ^www\.a-alerts\.nl$ [NC]
  RewriteRule ^(.*)$ https://a-alerts.nl/$1 [R=301,L,NE]

  # Altijd https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L,NE]

  # Oude tekstpagina's → eigen pagina's
  RewriteCond %{QUERY_STRING} (^|&)p=privacy(&|$)
  RewriteRule ^info/?$ /privacy/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)p=cookies(&|$)
  RewriteRule ^info/?$ /cookies/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)p=terms(&|$)
  RewriteRule ^info/?$ /voorwaarden/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)p=disclaimer(&|$)
  RewriteRule ^info/?$ /disclaimer/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)p=changelog(&|$)
  RewriteRule ^info/?$ /wat-is-nieuw/? [R=301,L]

  # Pagina's die de server maakt (website/p, PHP): statistieken, afkortingen, plaats, eenheid, post en de sitemap
  # daarvan. De inhoud staat meteen in de HTML (voor Google en link-previews).
  RewriteRule ^statistieken/?$ /p/statistieken.php [L,QSA]
  RewriteRule ^afkortingen/?$ /p/afkortingen.php [L]
  RewriteRule ^plaats/([a-z0-9-]{1,60})/?$ /p/plaats.php?s=$1 [L]
  RewriteRule ^eenheid/([0-9]{5,12})/?$ /p/eenheid.php?c=$1 [L]
  RewriteRule ^post/([A-Za-z0-9_-]{3,60})/?$ /p/post.php?id=$1 [L]
  RewriteRule ^sitemap-p2000\.xml$ /p/sitemap.php [L]

  # Deellinks (apps, website, Homey): de pagina van de melding met de inhoud in de HTML en de deelafbeelding van
  # api.a-alerts.nl voor de link-preview. Met de app geïnstalleerd opent de link in de app (universal links / app links).
  # Ambulancemeldingen: noindex (zie website/p/melding.php). Een tekst achter de guid (/slug) mag, wordt genegeerd.
  RewriteRule ^melding/([a-z]+)/([A-Za-z0-9_-]{8,64})(/[a-z0-9-]*)?/?$ /p/melding.php?d=$1&g=$2 [L]
  # Een gedeeld adres van de live pager zelf (/pager/?melding=<guid>, bv. via de deelknop van de browser): link-previews
  # (WhatsApp, Telegram, Facebook, X, Slack, Discord, LinkedIn, iMessage) krijgen dezelfde pagina met afbeelding als
  # de deellink; mensen zien gewoon de live pager.
  RewriteCond %{HTTP_USER_AGENT} (WhatsApp|TelegramBot|facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|LinkedInBot|SkypeUriPreview|Applebot|redditbot|Pinterest|Signal) [NC]
  RewriteCond %{QUERY_STRING} (^|&)melding=([A-Za-z0-9_-]{8,64})(&|$)
  RewriteRule ^pager/?$ /p/melding.php?d=onbekend&g=%2 [L]
  RewriteRule ^waarschuwing/(burgernet|nlalert|knmi|amber|vermistkind|vnog):.+$ /deel/$1.html [L]

  # Nieuws: /nieuws/<id> is dezelfde pagina; de JavaScript toont het artikel of liveblog.
  # Bestaat de deelpagina (met de afbeelding van het artikel) al, dan die; anders de gewone pagina.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^nieuws/[pwlr]-[0-9a-f]{12}/?$ /nieuws/index.html [L]

  # Oudere deellinks: /melding/<guid> en /waarschuwing/<id> → live pager
  RewriteRule ^melding/([A-Za-z0-9_-]+)/?$ /pager/?melding=$1 [R=302,L,QSA]
  RewriteRule ^waarschuwing/(.+)$ /pager/?waarschuwing=$1 [R=302,L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(webp|png|jpg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|json|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Android-app: altijd de nieuwste APK, als download (niet openen in de browser)
  <FilesMatch "\.apk$">
    Header set Cache-Control "no-cache"
    Header set Content-Disposition "attachment; filename=A-Alerts.apk"
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

<Files "apple-app-site-association">
  ForceType application/json
</Files>

<IfModule mod_mime.c>
  AddType application/vnd.android.package-archive .apk
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
</IfModule>
