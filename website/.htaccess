# A-Alerts – a-alerts.nl
# Upload naar de webroot van a-alerts.nl. Laat p2000-apeldoorn.nl (en www) als alias
# naar dezelfde map wijzen, of zet dit bestand ook in de webroot van p2000-apeldoorn.nl.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Oude domein → nieuw domein (301, pad en query blijven behouden)
  RewriteCond %{HTTP_HOST} ^(www\.)?p2000-apeldoorn\.nl$ [NC]
  RewriteRule ^(.*)$ https://a-alerts.nl/$1 [R=301,L,NE]

  # www → zonder www
  RewriteCond %{HTTP_HOST} ^www\.a-alerts\.nl$ [NC]
  RewriteRule ^(.*)$ https://a-alerts.nl/$1 [R=301,L,NE]

  # Altijd https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L,NE]

  # Oude tekstpagina's → eigen pagina's
  RewriteCond %{QUERY_STRING} (^|&)p=privacy(&|$)
  RewriteRule ^info/?$ /privacy/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)p=cookies(&|$)
  RewriteRule ^info/?$ /cookies/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)p=terms(&|$)
  RewriteRule ^info/?$ /voorwaarden/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)p=disclaimer(&|$)
  RewriteRule ^info/?$ /disclaimer/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)p=changelog(&|$)
  RewriteRule ^info/?$ /wat-is-nieuw/? [R=301,L]

  # Korte link: /statistieken
  RewriteRule ^statistieken/?$ /pager/#stats [R=302,L,NE]

  # Deellinks (apps, website, Homey): een kleine pagina met de banner van de dienst of bron voor de link-preview,
  # die meteen doorstuurt naar de live pager. Met de app geïnstalleerd opent de link in de app (universal links / app links).
  RewriteRule ^melding/(brandweer|ambulance|politie|traumaheli)/[A-Za-z0-9_-]+/?$ /deel/$1.html [L]
  RewriteRule ^melding/[a-z]+/[A-Za-z0-9_-]+/?$ /deel/melding.html [L]
  RewriteRule ^waarschuwing/(burgernet|nlalert|knmi|amber|vermistkind|vnog):.+$ /deel/$1.html [L]

  # Nieuws: /nieuws/<id> is dezelfde pagina; de JavaScript toont het artikel of liveblog.
  # Bestaat de deelpagina (met de afbeelding van het artikel) al, dan die; anders de gewone pagina.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^nieuws/[pwlr]-[0-9a-f]{12}/?$ /nieuws/index.html [L]

  # Oudere deellinks: /melding/<guid> en /waarschuwing/<id> → live pager
  RewriteRule ^melding/([A-Za-z0-9_-]+)/?$ /pager/?melding=$1 [R=302,L,QSA]
  RewriteRule ^waarschuwing/(.+)$ /pager/?waarschuwing=$1 [R=302,L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(webp|png|jpg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|json|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Android-app: altijd de nieuwste APK, als download (niet openen in de browser)
  <FilesMatch "\.apk$">
    Header set Cache-Control "no-cache"
    Header set Content-Disposition "attachment; filename=A-Alerts.apk"
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

<Files "apple-app-site-association">
  ForceType application/json
</Files>

<IfModule mod_mime.c>
  AddType application/vnd.android.package-archive .apk
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
</IfModule>
