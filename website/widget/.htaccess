# Widgets: these pages are meant to be shown in an iframe on other websites. The site-wide X-Frame-Options SAMEORIGIN
# (see ../.htaccess) would block that, so here no frame rule is sent at all: also site builders that put embed code
# in a sandboxed frame (origin "null", which "frame-ancestors *" does not allow) can show them. Blocking a site goes
# via beheer (Widgets).
<IfModule mod_headers.c>
  Header always unset X-Frame-Options
  Header always unset Content-Security-Policy
</IfModule>
