// Shared build settings.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 2
DEVELOPMENT_TEAM = EU3UY476T6

// The app's own API (server/ in this repo). "//" starts a comment in .xcconfig, hence https:/$()/
