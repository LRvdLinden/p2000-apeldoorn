// Shared build settings.
MARKETING_VERSION = 2.0.2
CURRENT_PROJECT_VERSION = 108
DEVELOPMENT_TEAM = EU3UY476T6

// The app's own API: api.a-alerts.nl (own PHP/MySQL server, LRvdLinden/app.lrvdlinden.a-alerts.api), which replaces
// the Cloudflare Worker. "//" starts a comment in .xcconfig, hence https:/$()/
P2000_API_URL = https:/$()/api.a-alerts.nl

// Optional local overrides (not in git), e.g. a local wrangler dev URL while testing.
#include? "Secrets.xcconfig"
